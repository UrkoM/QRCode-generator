# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Airtable
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_PROSPECTS_TABLE=Prospects
AIRTABLE_PERSONAS_TABLE=LinkedIn_Personas
AIRTABLE_MESSAGES_TABLE=Messages_Log

# LinkedIn (Modo B - perfil real)
LINKEDIN_EMAIL=tu@email.com
LINKEDIN_PASSWORD=tu_password
LINKEDIN_COOKIES_FILE=linkedin_session.json

# Phantombuster (opcional)
PHANTOMBUSTER_API_KEY=

# Calendly
CALENDLY_LINK=https://calendly.com/tu-usuario/30min

# Rate limits
MAX_INVITES_PER_DAY_AUTONOMOUS=20
MAX_INVITES_PER_DAY_COPILOT=30
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=480

# Campaign
CAMPAIGN_ID=campaign_001
DRY_RUN=false

# Follow-up delays (días)
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
FOLLOWUP_3_DAYS=14

# Approval gate (Modo B: pedir aprobación antes de enviar)
APPROVAL_GATE_ENABLED=false
APPROVAL_TIMEOUT_HOURS=24

# Proxies (Modo A - un proxy residencial por cuenta)
PROXY_LIST_FILE=proxies.txt
